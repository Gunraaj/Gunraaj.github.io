---
import { siteConfig } from "../content/site";
const { technical, soft, creative } = siteConfig.advancedSkills;
const dash = (s?: string) => (s ?? "").replace(/\s*[—–]\s*/g, ", ");
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
  <!-- Engineering: the core of the profile, so it gets the widest tile -->
  <div data-reveal class="lg:col-span-7 rounded-xl border border-primary/25 bg-primary/[0.06] p-6 sm:p-8">
    <h3 class="text-sm font-medium text-primary mb-6">Engineering</h3>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-7">
      {technical.map((s) => (
        <li>
          <p class="text-lg font-semibold text-heading tracking-tight">{s.name}</p>
          <p class="mt-1 text-xs font-mono text-muted leading-relaxed">{s.details}</p>
          {s.artefact && <p class="mt-3 text-sm text-text leading-relaxed">{dash(s.artefact)}</p>}
        </li>
      ))}
    </ul>
  </div>

  <div data-reveal class="lg:col-span-5 rounded-xl border border-border bg-surface p-6 sm:p-8">
    <h3 class="text-sm font-medium text-primary mb-6">Design and media</h3>
    <ul class="divide-y divide-border">
      {creative.map((s) => (
        <li class="py-3 first:pt-0 last:pb-0">
          <p class="font-semibold text-heading">{s.name}</p>
          <p class="mt-0.5 text-sm text-muted leading-relaxed line-clamp-2">{dash(s.evidence)}</p>
        </li>
      ))}
    </ul>
  </div>

  <div data-reveal class="lg:col-span-12 rounded-xl border border-border bg-surface p-6 sm:p-8">
    <h3 class="text-sm font-medium text-primary mb-6">Leadership and communication</h3>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {soft.map((s) => (
        <li>
          <p class="font-semibold text-heading">{s.name}</p>
          <p class="mt-1 text-sm text-muted leading-relaxed">{dash(s.evidence)}</p>
        </li>
      ))}
    </ul>
  </div>
</div>

<p data-reveal class="mt-12 max-w-[68ch] text-lg text-text leading-relaxed">
  <span class="text-heading font-medium">Systems over syntax.</span> Tuning a PI controller for a motor and shaping UI states in Figma use the same habit: understand the whole system, then follow the signal. Debugging a PCB trace and colour-grading a video in Premiere Pro both come down to controlling a flow of signals, electrical or visual.
</p>
