---
import { siteConfig } from "../content/site";
const { name, title, identityLine, social } = siteConfig.profile;
---

<section id="hero" class="relative min-h-[100dvh] flex flex-col justify-center pt-24 pb-10 overflow-hidden">
  <div class="relative w-full max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10">
    <p data-hero-item class="inline-flex items-center gap-2 mb-5 text-sm text-muted">
      <span class="relative flex w-2 h-2">
        <span class="absolute inset-0 rounded-full bg-primary/60 motion-safe:animate-ping"></span>
        <span class="relative w-2 h-2 rounded-full bg-primary"></span>
      </span>
      Available for opportunities
    </p>

    <h1 data-hero-name class="hero-name text-heading">{name}</h1>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-6 md:items-end">
      <p data-hero-item class="md:col-span-7 lg:col-span-6 text-lg sm:text-xl text-text leading-snug max-w-[46ch]">
        <span class="text-heading font-medium">{title.replace(" · ", ". ")}.</span>
        {" "}{identityLine}
      </p>
      <div data-hero-item class="md:col-span-5 lg:col-span-6 flex flex-wrap gap-3 md:justify-end">
        <a href={social.resume} class="btn btn-primary">
          Download CV
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </a>
        <a href="#projects" class="btn btn-ghost">See projects</a>
      </div>
    </div>

    <!-- Signature: live hybrid ANN + PI speed loop (from the PM-BLDC project) -->
    <div
      data-ann
      tabindex="0"
      role="slider"
      aria-label="Simulated motor speed setpoint. Move the pointer up or down over the panel, or use arrow keys, to change it."
      aria-valuemin="300"
      aria-valuemax="3000"
      aria-valuenow="1500"
      class="ann mt-10 rounded-xl border border-border bg-surface/60"
    >
      <canvas class="block w-full h-[220px] sm:h-[240px] lg:h-[clamp(220px,30vh,320px)]"></canvas>
      <div class="ann-readout">
        <dl class="flex flex-wrap gap-x-8 gap-y-1">
          <div class="flex gap-2"><dt>setpoint</dt><dd class="text-heading"><span data-ann-r>1500</span> rpm</dd></div>
          <div class="flex gap-2"><dt>speed</dt><dd class="text-heading"><span data-ann-w>0</span> rpm</dd></div>
          <div class="flex gap-2"><dt>K<sub>p</sub> from ANN</dt><dd class="text-heading" data-ann-kp>1.40</dd></div>
        </dl>
        <p class="hidden md:block">Hybrid ANN + PI speed control, simulated live. Move up or down to change speed.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-name {
    font-family: "Geist", system-ui, sans-serif;
    font-weight: 700;
    font-size: min(13.6vw, 12.4rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
    white-space: nowrap;
    margin-left: -0.04em;
  }
  @media (max-width: 639px) {
    .hero-name { white-space: normal; font-size: clamp(3rem, 16vw, 5rem); }
  }
  .ann { cursor: ns-resize; touch-action: pan-y; padding: 1rem 1rem 0; }
  .ann-readout {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid rgb(var(--color-border));
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    color: rgb(var(--color-muted));
  }
</style>
