---
import { siteConfig } from "../content/site";
const [first, ...rest] = siteConfig.profile.name.split(" ");
---

<section id="hero" class="relative min-h-[100svh] flex flex-col justify-center bg-background overflow-hidden pt-28 pb-10">
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-6 items-end">
      <div class="lg:col-span-8 flex flex-col items-start">
        <p data-hero-item class="inline-flex items-center gap-2 mb-6 text-xs font-mono uppercase tracking-[0.18em] text-muted">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          Available for opportunities
        </p>

        <h1 data-hero-name class="hero-name text-heading mb-6">
          <span class="block">{first}</span>
          <span class="block text-primary">{rest.join(" ")}</span>
        </h1>

        <p data-hero-item class="text-lg sm:text-xl font-medium text-heading mb-3 max-w-xl">
          {siteConfig.profile.title}
        </p>
        <p data-hero-item class="text-base text-text max-w-lg mb-8 leading-relaxed">
          {siteConfig.profile.identityLine}
        </p>

        <div data-hero-item class="flex flex-wrap gap-3">
          <a href={siteConfig.profile.social.resume} class="btn btn-primary">
            Download CV
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
          </a>
          <a href="#projects" class="btn btn-ghost">See projects</a>
        </div>
      </div>

      <figure class="lg:col-span-4 flex flex-col items-start lg:items-end">
        <div data-hero-photo class="relative w-56 h-64 sm:w-64 sm:h-72 lg:w-full lg:h-[380px] overflow-hidden rounded-md border border-border">
          <img
            src="/profile.jpg"
            alt={siteConfig.profile.name}
            class="w-full h-full object-cover object-[center_20%]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption data-hero-item class="mt-3 text-[11px] font-mono uppercase tracking-[0.16em] text-muted">
          B.Tech EE · PDEU '27
        </figcaption>
      </figure>
    </div>
  </div>

  <!-- Signature: oscilloscope trace that settles as you scroll -->
  <div class="relative mt-12 w-full" aria-hidden="true">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="scope">
        <svg data-scope viewBox="0 0 1200 240" preserveAspectRatio="none" class="w-full h-28 sm:h-36 lg:h-44 block">
          <defs>
            <pattern id="scope-grid" width="60" height="30" patternUnits="userSpaceOnUse">
              <path d="M60 0H0V30" fill="none" class="scope-grid-line" />
            </pattern>
          </defs>
          <rect width="1200" height="240" fill="url(#scope-grid)" />
          <line x1="0" y1="120" x2="1200" y2="120" class="scope-axis" />
          <path data-scope-ghost class="scope-ghost" vector-effect="non-scaling-stroke" />
          <path data-scope-trace class="scope-trace" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="scope-readout">
          <span><span class="text-primary">CH1</span> damped response</span>
          <span>ζ = <span data-scope-zeta>0.00</span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <dl data-hero-item class="grid grid-cols-3 gap-4 mt-6 font-mono text-xs text-muted">
      <div><dt class="sr-only">Featured projects</dt><dd><span class="text-heading text-base">4</span> featured projects</dd></div>
      <div><dt class="sr-only">Design experience</dt><dd><span class="text-heading text-base">2+</span> yrs design</dd></div>
      <div><dt class="sr-only">Leadership roles</dt><dd><span class="text-heading text-base">3</span> leadership roles</dd></div>
    </dl>
  </div>
</section>

<style>
  .hero-name {
    font-family: "Archivo", system-ui, sans-serif;
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(2.75rem, 8vw, 7.5rem);
    white-space: nowrap;
    line-height: 0.88;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }
  .scope {
    border-top: 1px solid rgb(var(--color-border));
    border-bottom: 1px solid rgb(var(--color-border));
  }
  .scope-grid-line {
    stroke: rgb(var(--color-border) / 0.7);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .scope-axis {
    stroke: rgb(var(--color-muted) / 0.5);
    stroke-dasharray: 4 6;
    vector-effect: non-scaling-stroke;
  }
  .scope-trace {
    fill: none;
    stroke: rgb(var(--color-primary));
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .scope-ghost {
    fill: none;
    stroke: rgb(var(--color-primary) / 0.25);
    stroke-width: 8;
    filter: blur(4px);
  }
  .scope-readout {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(var(--color-muted));
  }
</style>
