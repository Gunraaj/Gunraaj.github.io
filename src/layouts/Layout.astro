---
import { siteConfig } from "../content/site";
import Navbar from "../components/Navbar.astro";
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	showPreloader?: boolean;
}

const {
	title,
	description = siteConfig.profile.identityLine,
	showPreloader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Optimization -->
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || Astro.url.origin)} />
		<meta name="robots" content="index, follow" />
		
		<!-- OpenGraph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={`${title} | ${siteConfig.profile.name}`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/profile.jpg', Astro.site || Astro.url.origin)} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={`${title} | ${siteConfig.profile.name}`} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL('/profile.jpg', Astro.site || Astro.url.origin)} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": siteConfig.profile.name,
			"jobTitle": siteConfig.profile.title,
			"url": Astro.site || Astro.url.origin,
			"sameAs": [
				siteConfig.profile.social.linkedin,
				siteConfig.profile.social.github
			]
		})} />

		<!-- Google Fonts — Premium Stack -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500&family=Noto+Serif+Gurmukhi:wght@400;600&display=swap"
			rel="stylesheet"
		/>

		<ViewTransitions />

		<!-- Speculation Rules for Instant Case Study Preloading -->
		<script type="speculationrules" is:inline>
			{
				"prerender": [
					{
						"source": "document",
						"where": {
							"href_matches": [
								"/projects/*",
								"**/projects/*"
							]
						},
						"eagerly": "hover"
					}
				]
			}
		</script>

		<script is:inline>
			const setTheme = () => {
				if (
					localStorage.getItem("color-theme") === "dark" ||
					(!("color-theme" in localStorage) &&
						window.matchMedia("(prefers-color-scheme: dark)")
							.matches)
				) {
					document.documentElement.classList.add("dark");
				} else {
					document.documentElement.classList.remove("dark");
				}
			};
			const setMotion = () => {
				if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches)
					document.documentElement.classList.add("motion-ok");
			};
			setTheme();
			setMotion();
			document.addEventListener("astro:after-swap", () => { setTheme(); setMotion(); });
		</script>

		<title>{title} | {siteConfig.profile.name}</title>
	</head>
	<body
		class="bg-background text-text font-sans antialiased selection:bg-primary selection:text-white"
	>
		<div id="scroll-progress" aria-hidden="true"></div>
		<div class="bg-dots" aria-hidden="true" transition:persist></div>
		<div class="bg-dots-lit" aria-hidden="true" transition:persist></div>
		<div class="ambient-glow" aria-hidden="true" transition:persist></div>
		<div id="cursor-ring" class="cursor-ring" aria-hidden="true" transition:persist></div>
		<div id="cursor-dot" class="cursor-dot" aria-hidden="true" transition:persist></div>
		<Navbar />

		{
			showPreloader && (
				<div
					id="preloader"
					class="fixed inset-0 z-[10000] bg-background flex items-center justify-center overflow-hidden pointer-events-auto transition-opacity duration-500"
				>
					<div class="absolute inset-x-0 top-0 h-full opacity-[0.03] select-none pointer-events-none font-serif text-[8vw] leading-none whitespace-nowrap overflow-hidden flex flex-col items-center">
						<div class="animate-marquee-left py-4">
							ੴ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਨਿਰਭਉ ਨਿਰਵੈਰੁ ਅਕਾਲ ਮੂਰਤਿ ਅਜੂਨੀ
							ਸੈਭੰ ਗੁਰ ਪ੍ਰਸਾਦਿ ॥
						</div>
						<div class="animate-marquee-right py-4 text-primary">
							ੴ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਨਿਰਭਉ ਨਿਰਵੈਰੁ ਅਕਾਲ ਮੂਰਤਿ ਅਜੂਨੀ
							ਸੈਭੰ ਗੁਰ ਪ੍ਰਸਾਦਿ ॥
						</div>
						<div class="animate-marquee-left py-4">
							ੴ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਨਿਰਭਉ ਨਿਰਵੈਰੁ ਅਕਾਲ ਮੂਰਤਿ ਅਜੂਨੀ
							ਸੈਭੰ ਗੁਰ ਪ੍ਰਸਾਦਿ ॥
						</div>
					</div>
					<div class="relative z-10 text-center px-6">
						<div class="h-32 flex items-center justify-center mb-8">
							<div
								id="loader-text"
								class="text-5xl md:text-7xl font-serif text-heading"
							/>
						</div>
						<div
							id="loader-quote"
							class="max-w-2xl mx-auto opacity-0 transition-opacity duration-500"
						>
							<p class="text-base md:text-lg font-mono text-muted">
								"Recognize the whole human race as one."
							</p>
						</div>
					</div>
					<div class="absolute bottom-16 left-1/2 -translate-x-1/2 w-48 h-[2px] bg-white/5 overflow-hidden">
						<div
							id="loader-progress"
							class="h-full bg-primary w-0 transition-all duration-[1800ms] ease-linear"
						/>
					</div>
				</div>
			)
		}



		<main
			id="main-content"
			class="min-h-screen relative z-10"
			data-preloading={showPreloader ? "" : undefined}
		>
			<slot />
		</main>
		<footer class="bg-surface py-12 mt-20 border-t border-border/40 relative z-10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-muted text-sm">
				<p>
					&copy; {new Date().getFullYear()} {siteConfig.profile.name}. All rights reserved.
				</p>
				<div class="flex items-center gap-6">
					<a href={siteConfig.profile.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">GitHub</a>
					<a href={siteConfig.profile.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">LinkedIn</a>
					<button data-copy-email={siteConfig.profile.social.email} class="hover:text-primary transition-colors cursor-pointer"><span class="copy-text">Email</span></button>
				</div>
			</div>
		</footer>

		<!-- Konami Code Easter Egg Overlay -->
		<div
			id="easter-egg-overlay"
			class="fixed inset-0 z-[99999] pointer-events-none opacity-0 transition-opacity duration-300 flex items-center justify-center"
		>
			<div class="absolute inset-0 bg-primary/20 animate-pulse"></div>
			<div
				id="easter-egg-text"
				class="relative text-6xl md:text-9xl font-serif italic text-white drop-shadow-[0_0_30px_rgba(255,255,255,0.8)] scale-0 transition-transform duration-500 select-none"
			>
				⚡ PLUS ULTRA ⚡
			</div>
		</div>

		<script>
			import { initMotion } from "../scripts/motion";

			function initCore() {
				// --- SCROLL REVEAL (project pages) ---
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting)
								entry.target.classList.add("is-visible");
						});
					},
					{ threshold: 0.1 },
				);
				document
					.querySelectorAll(".scroll-reveal")
					.forEach((el) => observer.observe(el));
				document
					.querySelectorAll(".stagger-fade")
					.forEach((el) => observer.observe(el));

				// --- COPY EMAIL FUNCTIONALITY ---
				document.querySelectorAll('[data-copy-email]').forEach(btn => {
					btn.addEventListener('click', (e) => {
						const email = btn.getAttribute('data-copy-email');
						navigator.clipboard.writeText(email);
						const textSpan = btn.querySelector('.copy-text');
						if (textSpan) {
							const originalText = textSpan.innerText;
							textSpan.innerText = "Copied!";
							setTimeout(() => textSpan.innerText = originalText, 2000);
						} else {
							const originalText = btn.innerText;
							btn.innerText = "Copied!";
							setTimeout(() => btn.innerText = originalText, 2000);
						}
					});
				});

				// --- KONAMI CODE EASTER EGG (↑↑↓↓←→←→BA) ---
				if (!window.konamiInitialized) {
					const konamiCode = [38, 38, 40, 40, 37, 39, 37, 39, 66, 65];
					let ki = 0;
					window.addEventListener("keydown", (e) => {
						if (e.keyCode === konamiCode[ki]) {
							ki++;
							if (ki === konamiCode.length) {
								ki = 0;
								const ov =
									document.getElementById(
										"easter-egg-overlay",
									);
								const tx =
									document.getElementById("easter-egg-text");
								if (ov && tx) {
									ov.style.opacity = "1";
									setTimeout(
										() =>
											(tx.style.transform =
												"scale(1) rotate(-3deg)"),
										100,
									);
									setTimeout(() => {
										tx.style.transform = "scale(0)";
										ov.style.opacity = "0";
									}, 2500);
								}
							}
						} else {
							ki = 0;
						}
					});
					window.konamiInitialized = true;
				}
			}

			document.addEventListener("astro:page-load", () => { initCore(); initMotion(); });
		</script>
	</body>
</html>

<style is:global>


	h1,
	h2,
	h3,
	h4 {
		font-family: "Geist", system-ui, sans-serif;
	}

	.motion-ok .scroll-reveal {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.motion-ok .scroll-reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@keyframes marquee-left {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}
	@keyframes marquee-right {
		0% {
			transform: translateX(-50%);
		}
		100% {
			transform: translateX(0);
		}
	}
	.animate-marquee-left {
		animation: marquee-left 40s linear infinite;
		display: flex;
		width: max-content;
	}
	.animate-marquee-right {
		animation: marquee-right 40s linear infinite;
		display: flex;
		width: max-content;
	}

	::selection {
		background-color: rgba(var(--color-primary) / 0.3);
		color: rgb(var(--color-heading));
	}
</style>
