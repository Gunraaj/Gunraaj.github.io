---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillMatrix from "../components/SkillMatrix.astro";
import ResumeSection from "../components/ResumeSection.astro";
import { siteConfig } from "../content/site";

const projects = siteConfig.projects.filter((p) => p.enabled);
// Bento rhythm on a 3-column grid: rows of [wide + normal] (alternating sides)
// mixed with rows of three, so every row is full and no two rows look alike.
const n = projects.length;
let pairRows = 1;
while (pairRows * 2 < n && (n - pairRows * 2) % 3 !== 0) pairRows++;
const tripleRows = Math.max(0, (n - pairRows * 2) / 3);
const wide = new Set<number>();
let idx = 0, pairsDone = 0;
for (let r = 0; idx < n; r++) {
  const usePair = pairsDone < pairRows && (r % 2 === 0 || tripleRows === 0 || r >= pairRows + tripleRows - 1);
  if (usePair) { wide.add(pairsDone % 2 === 0 ? idx : idx + 1); idx += 2; pairsDone++; }
  else idx += 3;
}
const stripEmoji = (s: string) => s.replace(/\p{Extended_Pictographic}️?/gu, "").trim();
---

<Layout title="Portfolio" showPreloader={true}>
  <Hero />

  <div class="border-y border-border py-3">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10 flex flex-wrap items-center gap-x-6 gap-y-1 text-sm text-muted">
      <span class="text-heading">{siteConfig.profile.program}</span>
      <span>{siteConfig.profile.institution}</span>
    </div>
  </div>

  <!-- ABOUT: photo carries the left column, text and facts fill the right -->
  <section id="about" class="py-24">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      <div data-reveal class="lg:col-span-4">
        <div class="aspect-[4/5] max-w-sm lg:max-w-none overflow-hidden rounded-xl border border-border">
          <img src="/profile.jpg" alt={`${siteConfig.profile.name} speaking at PDEU`} class="w-full h-full object-cover object-[center_25%]" loading="lazy" />
        </div>
      </div>

      <div class="lg:col-span-8 flex flex-col">
        <h2 class="section-title">Identity & Philosophy</h2>
        <div data-reveal class="mt-8 space-y-5 max-w-[68ch]">
          {siteConfig.about.details.map((paragraph, i) => (
            <p class:list={["leading-relaxed", i === 0 ? "text-xl text-heading" : "text-base text-text"]}>
              {paragraph}
            </p>
          ))}
        </div>

        <ul class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-px bg-border border border-border rounded-xl overflow-hidden">
          {siteConfig.about.quickFacts.map((fact) => (
            <li data-reveal class="bg-background p-5 text-sm font-medium text-heading">{stripEmoji(fact.text)}</li>
          ))}
        </ul>

        <figure data-reveal class="mt-10 lg:mt-auto pt-10">
          <blockquote>
            <p class="font-serif text-2xl md:text-3xl text-primary">ਮਨਿ ਜੀਤੈ ਜਗੁ ਜੀਤੁ</p>
            <p class="mt-2 text-text">Conquer your mind, and you conquer the world.</p>
          </blockquote>
          <figcaption class="mt-2 text-sm text-muted">Sri Guru Granth Sahib Ji</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="resume" class="py-24 section-alt">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10">
      <div class="mb-12 max-w-[68ch]">
        <h2 class="section-title">Curriculum Vitae</h2>
        <p data-reveal class="section-subtitle">Education, work experience, certifications and leadership.</p>
      </div>
      <div data-reveal>
        <ResumeSection />
      </div>
    </div>
  </section>

  <section id="projects" class="py-24">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10">
      <div class="mb-12 max-w-[68ch]">
        <h2 class="section-title">Research & Projects</h2>
        <p data-reveal class="section-subtitle">Case studies with the method, the results and the code.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 md:grid-flow-dense gap-4">
        {projects.map((project, i) => (
          <div data-reveal class:list={[wide.has(i) && "md:col-span-2"]}>
            <ProjectCard project={project} wide={wide.has(i)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="skills" class="py-24 section-alt">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10">
      <div class="mb-12 max-w-[68ch]">
        <h2 class="section-title">Skills</h2>
        <p data-reveal class="section-subtitle">What I use, and where I have used it.</p>
      </div>
      <SkillMatrix />
    </div>
  </section>

  <section id="contact" class="py-24 border-t border-border">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:items-end">
      <div class="lg:col-span-7">
        <h2 class="contact-title text-heading">Let's build something that moves.</h2>
        <p data-reveal class="mt-5 text-lg text-text max-w-[52ch]">Open to internships, research and engineering collaborations.</p>
      </div>
      <div data-reveal class="lg:col-span-5 flex flex-wrap gap-3 lg:justify-end">
        <button data-copy-email={siteConfig.profile.social.email} class="btn btn-primary">
          <span class="copy-text">Copy email</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        </button>
        <a href={siteConfig.profile.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">LinkedIn</a>
        <a href={siteConfig.profile.social.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">GitHub</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-title {
    font-weight: 700;
    font-size: clamp(2.25rem, 5.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
</style>
